/-- [string_ukkonen::test_suffixes_all_reachable]: loop 0:
    Source: 'src/lib.rs', lines 538:4-544:5
    Visibility: public -/
@[rust_loop]
def test_suffixes_all_reachable_loop
  (s : Array Std.Usize 4#usize) (t : SuffixTree) (n : Std.Usize)
  (missed : Std.Usize) (i : Std.Usize) :
  Result Std.Usize
  := do
  if i < n
  then
    let s1 := alloc.vec.Vec.deref t.next
    let s2 ← lift (Array.to_slice s)
    let i1 ← n - i
    let i2 := alloc.vec.Vec.len t.next
    let start ← t_walk_buf s1 s2 i i1 i2
    let i3 := alloc.vec.Vec.len t.next
    let missed1 ← if start = i3
                    then missed + 1#usize
                    else ok missed
    let i4 ← i + 1#usize
    test_suffixes_all_reachable_loop s t n missed1 i4
  else ok missed
partial_fixpoint

