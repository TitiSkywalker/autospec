  let s ←
    lift (Array.to_slice
      (Array.make 4#usize [ 97#usize, 98#usize, 97#usize, 98#usize ]))
  let t ← suffix_tree s
  let s1 ←
    lift (Array.to_slice
      (Array.make 4#usize [ 97#usize, 98#usize, 97#usize, 98#usize ]))
  let n := Slice.len s1
  let missed ←
    test_suffixes_all_reachable_loop
      (Array.make 4#usize [ 97#usize, 98#usize, 97#usize, 98#usize ]) t n
      0#usize 0#usize
  massert (missed = 0#usize)

