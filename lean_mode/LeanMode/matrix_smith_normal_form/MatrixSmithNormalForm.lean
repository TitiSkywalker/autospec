  Result SmithForm
  := do
  let a ← alloc.slice.Slice.to_vec IntClone matrix
  let i ← nrows * nrows
  let p ← alloc.vec.from_elem IntClone 0 i
  let i1 ← ncols * ncols
  let q ← alloc.vec.from_elem IntClone 0 i1
  let p1 ← smith_normal_form_loop0 nrows p 0#usize
  let q1 ← smith_normal_form_loop1 ncols q 0#usize
  let nm ← if nrows < ncols
             then ok nrows
             else ok ncols
