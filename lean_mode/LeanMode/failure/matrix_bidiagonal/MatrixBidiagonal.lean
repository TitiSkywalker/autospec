@[rust_loop_body]
def bidiagonal_decompose_loop1.body
  (nrows : Std.Usize) (ncols : Std.Usize) (min_nm : Std.Usize)
  (matrix : Slice Rat) (diagonal : Slice Rat) (off_diagonal : Slice Rat)
  (col_axis_work : Slice Rat) (row_axis_work : Slice Rat) (work : Slice Rat)
  (sub_work : Slice Rat) (ite : Std.Usize) :
  Result (ControlFlow ((Slice Rat) × (Slice Rat) × (Slice Rat) × (Slice Rat)
    × (Slice Rat) × (Slice Rat) × (Slice Rat) × Std.Usize) ((Slice Rat) ×
    (Slice Rat) × (Slice Rat) × (Slice Rat) × (Slice Rat) × (Slice Rat) ×
    (Slice Rat)))
  := do
  let i ← min_nm - 1#usize
  if ite < i
  then
    let (fl, matrix1, row_axis_work1, work1, sub_work1) ←
      clear_row matrix nrows ncols ite 0#usize row_axis_work work sub_work
    let s ← Slice.update diagonal ite fl
    let (fl1, matrix2, col_axis_work1, sub_work2) ←
      clear_column matrix1 nrows ncols ite 1#usize col_axis_work sub_work1
    let s1 ← Slice.update off_diagonal ite fl1
    let ite1 ← ite + 1#usize
    ok (cont (matrix2, s, s1, col_axis_work1, row_axis_work1, work1, sub_work2,
      ite1))
  else
    ok (done (matrix, diagonal, off_diagonal, col_axis_work, row_axis_work,
      work, sub_work))

