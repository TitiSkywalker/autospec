/-- [matrix_bidiagonal::bidiagonal_decompose]:
    Source: 'src/lib.rs', lines 381:0-428:1
    Visibility: public -/
def bidiagonal_decompose
  (matrix : Slice Rat) (nrows : Std.Usize) (ncols : Std.Usize)
  (diagonal : Slice Rat) (off_diagonal : Slice Rat) (col_axis_work : Slice Rat)
  (row_axis_work : Slice Rat) (work : Slice Rat) (sub_work : Slice Rat) :
  Result (Bool × (Slice Rat) × (Slice Rat) × (Slice Rat) × (Slice Rat) ×
    (Slice Rat) × (Slice Rat) × (Slice Rat))
  := do
  massert (nrows > 0#usize)
  massert (ncols > 0#usize)
  let min_nm ← if nrows < ncols
                 then ok nrows
                 else ok ncols
  if nrows >= ncols
  then
    let (matrix1, diagonal1, off_diagonal1, col_axis_work1, row_axis_work1,
      work1, sub_work1) ←
      bidiagonal_decompose_loop0 matrix nrows ncols diagonal off_diagonal
        col_axis_work row_axis_work work sub_work min_nm 0#usize
    let i ← min_nm - 1#usize
    let (fl, matrix2, col_axis_work2, sub_work2) ←
      clear_column matrix1 nrows ncols i 0#usize col_axis_work1 sub_work1
    let diagonal2 ← Slice.update diagonal1 i fl
    ok (true, matrix2, diagonal2, off_diagonal1, col_axis_work2,
      row_axis_work1, work1, sub_work2)
  else
    let (matrix1, diagonal1, off_diagonal1, col_axis_work1, row_axis_work1,
      work1, sub_work1) ←
      bidiagonal_decompose_loop1 matrix nrows ncols diagonal off_diagonal
        col_axis_work row_axis_work work sub_work min_nm 0#usize
    let i ← min_nm - 1#usize
    let (fl, matrix2, row_axis_work2, work2, sub_work2) ←
      clear_row matrix1 nrows ncols i 0#usize row_axis_work1 work1 sub_work1
    let diagonal2 ← Slice.update diagonal1 i fl
    ok (false, matrix2, diagonal2, off_diagonal1, col_axis_work1,
      row_axis_work2, work2, sub_work2)

/-- [matrix_bidiagonal::bidiagonal]:
    Source: 'src/lib.rs', lines 437:0-458:1
    Visibility: public -/
def bidiagonal
  (matrix : Slice Rat) (nrows : Std.Usize) (ncols : Std.Usize) :
  Result (((alloc.vec.Vec Rat) × (alloc.vec.Vec Rat) × Bool × (alloc.vec.Vec
    Rat)) × (Slice Rat))
  := do
  let _f64_const_0 := (0 : Rat)
  let min_nm ← if nrows < ncols
                 then ok nrows
                 else ok ncols
  let diagonal ←
    alloc.vec.from_elem RatClone _f64_const_0 min_nm
  let i ← if min_nm > 0#usize
            then min_nm - 1#usize
            else ok 0#usize
  let off_diagonal ←
    alloc.vec.from_elem RatClone _f64_const_0 i
  let col_axis_work ←
    alloc.vec.from_elem RatClone _f64_const_0 nrows
  let row_axis_work ←
    alloc.vec.from_elem RatClone _f64_const_0 ncols
  let i1 ← nrows * ncols
  let sub_work ← alloc.vec.from_elem RatClone _f64_const_0 i1
  let uv ← alloc.slice.Slice.to_vec RatClone matrix
  let (s, deref_mut_back) ← lift (alloc.vec.Vec.deref_mut diagonal)
  let (s1, deref_mut_back1) ← lift (alloc.vec.Vec.deref_mut off_diagonal)
  let (s2, _) ← lift (alloc.vec.Vec.deref_mut col_axis_work)
  let (s3, _) ← lift (alloc.vec.Vec.deref_mut row_axis_work)
  let (s4, _) ← lift (alloc.vec.Vec.deref_mut col_axis_work)
  let (s5, _) ← lift (alloc.vec.Vec.deref_mut sub_work)
  let (upper_diagonal, matrix1, s6, s7, _, _, _, _) ←
    bidiagonal_decompose matrix nrows ncols s s1 s2 s3 s4 s5
  let diagonal1 := deref_mut_back s6
  let off_diagonal1 := deref_mut_back1 s7
  ok ((diagonal1, off_diagonal1, upper_diagonal, uv), matrix1)

end matrix_bidiagonal
