def brooks_color
  (n : Std.Usize) (adj : Slice Std.Usize) :
  Result (alloc.vec.Vec Std.Usize)
  := do
  let col ← alloc.vec.from_elem core.clone.CloneUsize 0#usize n
  if n > 1#usize
  then
    let complete ← is_complete_graph n adj
    if complete
    then brooks_color_loop n col 0#usize
    else
      let delta ← max_degree n adj
      if delta <= 2#usize
      then
        let (conflict, c2) ← two_color n adj
        if conflict
        then let i ← delta + 1#usize
             greedy_coloring n adj i
        else ok c2
      else
        let (fv, fu, fw) ← find_brooks_pair n adj
        if fv < n
        then brooks_ordered_coloring n adj delta fv fu fw
        else
          let (found, val) ← backtrack_coloring n adj delta
          if found
          then ok val
          else let i ← delta + 1#usize
               greedy_coloring n adj i
  else ok col

