@[rust_loop]
def w_lens_ok_loop
  (lens : Slice Std.Usize) (ok1 : Bool) (sum : Std.Usize) (i : Std.Usize) :
  Result (Bool × Std.Usize)
  := do
  let i1 := Slice.len lens
  if i < i1
  then
    let l ← Slice.index_usize lens i
    let ok2 ← if l < 2#usize
                then ok false
                else ok ok1
    let sum1 ← sum + l
    let i2 ← i + 1#usize
    w_lens_ok_loop lens ok2 sum1 i2
  else ok (ok1, sum)
partial_fixpoint

/-- [string_maw::w_lens_ok]:
    Source: 'src/lib.rs', lines 448:0-464:1
    Visibility: public -/
def w_lens_ok
  (data : Slice Std.Usize) (lens : Slice Std.Usize) : Result Bool := do
  let (ok1, sum) ← w_lens_ok_loop lens true 0#usize 0#usize
  let i := Slice.len data
  if sum != i
  then ok false
  else ok ok1

/-- [string_maw::w_check]:
    Source: 'src/lib.rs', lines 468:0-482:1
    Visibility: public -/
def w_check (s : Slice Std.Usize) : Result Bool := do
  let (data, lens) ← maw s
  let (bd, bl) ← w_brute_maw s
  let s1 := alloc.vec.Vec.deref data
  let s2 := alloc.vec.Vec.deref lens
  let s3 := alloc.vec.Vec.deref bd
  let s4 := alloc.vec.Vec.deref bl
  let b ← w_same_set s1 s2 s3 s4
  let ok1 ← if b
              then ok true
              else ok false
  let s5 := alloc.vec.Vec.deref data
  let s6 := alloc.vec.Vec.deref lens
  let b1 ← w_absent_all s s5 s6
  let ok2 ← if b1
              then ok ok1
              else ok false
  let s7 := alloc.vec.Vec.deref data
  let s8 := alloc.vec.Vec.deref lens
  let b2 ← w_lens_ok s7 s8
  if b2
  then ok ok2
  else ok false

