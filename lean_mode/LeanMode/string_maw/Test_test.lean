def test_empty : Result Unit := do
  let s ← lift (Array.to_slice (Std.Array.empty Std.Usize))
  let (data, lens) ← maw s
  let left_val := alloc.vec.Vec.len data
  massert (left_val = 0#usize)
  let left_val1 := alloc.vec.Vec.len lens
  massert (left_val1 = 0#usize)

