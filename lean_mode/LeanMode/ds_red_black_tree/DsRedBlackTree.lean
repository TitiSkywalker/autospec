def rbt_find (t : Tree) (v : Int) : Result Bool := do
  match t with
  | Tree.Empty => ok false
  | Tree.Node _ l k r =>
    if v < k
    then rbt_find l v
    else if v > k
         then rbt_find r v
         else ok true
  | Tree.DoubleBlackEmpty => ok false
